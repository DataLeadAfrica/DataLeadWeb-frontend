{
  "rewrites": [
    {
      "source": "/certificate/:number",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Ff]acebookexternalhit|[Ff]acebot|[Ll]inkedin[Bb]ot|[Ll]inkedIn|[Tt]witterbot|WhatsApp|[Ss]lackbot|Slack-ImgProxy|TelegramBot|Discordbot|Pinterest|redditbot|Applebot|[Bb]ingbot|[Gg]ooglebot|Embedly|Iframely|SkypeUriPreview|vkShare|W3C_Validator|[Nn]uzzel|[Qq]uora [Ll]ink [Pp]review|[Oo]utbrain|[Dd]uckduckbot|[Yy]andex).*"
        }
      ],
      "destination": "/api/certificate-meta?number=:number"
    },
    {
      "source": "/cowrie",
      "destination": "/cowrie-shell/index.html"
    },
    {
      "source": "/cowrie/",
      "destination": "/cowrie-shell/index.html"
    },
    {
      "source": "/giz/host-an-intern",
      "destination": "/giz/host-an-intern/index.html"
    },
    {
      "source": "/giz/employability",
      "destination": "/giz/employability/index.html"
    },
    {
      "source": "/giz/employability/record",
      "destination": "/giz/employability/record/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
